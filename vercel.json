{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "api": {
      "root": ".",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": { "service": "api" }
    }
  ],
  "daemons": {
    "samai-worker": {
      "root": ".",
      "entrypoint": "Dockerfile",
      "instances": { "fra1": 1 }
    }
  }
}
